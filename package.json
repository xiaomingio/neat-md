{
  "name": "neat-md",
  "displayName": "Neat MD - Markdown Editor",
  "description": "Edit Markdown with live preview, WYSIWYG editing, Mermaid diagrams, and KaTeX math.",
  "version": "0.1.0",
  "publisher": "xiaomingio",
  "license": "AGPL-3.0-only",
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "editor",
    "wysiwyg",
    "preview",
    "mermaid",
    "katex",
    "math"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaomingio/neat-md.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "neat-md.editor",
        "displayName": "Neat MD",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "neat-md.open",
        "title": "Open with Neat MD",
        "category": "Neat MD",
        "icon": "$(preview)"
      },
      {
        "command": "neat-md.openAsText",
        "title": "Reopen as Text",
        "category": "Neat MD",
        "icon": "$(go-to-file)"
      }
    ],
    "configuration": {
      "title": "Neat MD",
      "properties": {
        "neat-md.preview.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 10,
          "maximum": 32,
          "description": "Font size in pixels for Live mode and the preview."
        },
        "neat-md.preview.lineHeight": {
          "type": "number",
          "default": 1.6,
          "minimum": 1,
          "maximum": 3,
          "description": "Line height for Live mode and the preview."
        },
        "neat-md.preview.maxWidth": {
          "type": "number",
          "default": 900,
          "minimum": 0,
          "description": "Maximum content width in pixels (0 for no limit)."
        },
        "neat-md.attachments.folder": {
          "type": "string",
          "default": "assets",
          "markdownDescription": "Folder for pasted or dropped images and files, relative to the Markdown file. Use `${filename}` for the Markdown file name, for example `${filename}.assets`. Absolute paths are allowed."
        },
        "neat-md.attachments.embedImages": {
          "type": "boolean",
          "default": false,
          "description": "Embed pasted images in the Markdown as Base64 data instead of saving them as files."
        },
        "neat-md.mermaid.theme": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "dark",
            "neutral",
            "forest"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Follow the VS Code theme",
            "Mermaid default",
            "Mermaid dark",
            "Mermaid neutral",
            "Mermaid forest"
          ],
          "description": "Mermaid diagram theme."
        },
        "neat-md.toc.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "Deepest heading level listed by [toc]."
        },
        "neat-md.live.blockEdit": {
          "type": "string",
          "enum": [
            "doubleClick",
            "click"
          ],
          "default": "doubleClick",
          "enumDescriptions": [
            "Double-click a formula, diagram or table of contents to edit it",
            "A single click opens it for editing"
          ],
          "description": "How formulas, diagrams and the table of contents open for editing in Live mode. Their source appears above the rendered result, which stays visible while you type."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "neat-md.open",
          "when": "resourceLangId == markdown && activeCustomEditorId != 'neat-md.editor'",
          "group": "navigation"
        },
        {
          "command": "neat-md.openAsText",
          "when": "activeCustomEditorId == 'neat-md.editor'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "neat-md.openAsText",
          "when": "activeCustomEditorId == 'neat-md.editor'"
        }
      ]
    },
    "configurationDefaults": {
      "[markdown]": {
        "files.autoSave": "off"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "mkdir -p release && vsce package --readme-path MARKETPLACE.md --no-dependencies --githubBranch main --out release/",
    "test:ui": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "^22.9.0",
    "@types/turndown": "5.0.6",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.3.0",
    "turndown": "7.2.5"
  }
}
